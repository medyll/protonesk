[Unit]
Description=Protonesk MCP (streamable-http) for LLM agents
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/proton-bridge/src/mcp_server.py
WorkingDirectory=/opt/proton-bridge
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=PROTON_MCP_HTTP=1
Environment=PROTON_MCP_HOST=127.0.0.1
Environment=PROTON_MCP_PORT=8787

[Install]
WantedBy=default.target
