# Local hydroxide bridge connection (see scripts/install-hydroxide-service-windows.ps1 auth)
HYDROXIDE_HOST=127.0.0.1
HYDROXIDE_IMAP_PORT=1143
HYDROXIDE_SMTP_PORT=1025

# Your ProtonMail address
HYDROXIDE_USER=you@proton.me

# Bridge password printed by `hydroxide auth` (NOT your Proton password)
HYDROXIDE_PASSWORD=
